# ═══════════════════════════════════════════════════════════
# The Undesirables — MCP Sidecar Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your own keys:
#   cp .env.example .env

# ── eBay Browse API (Market Depth) ──────────────────────────
# Get your keys at: https://developer.ebay.com/my/keys
# 1. Sign in/Register at https://developer.ebay.com/signin
# 2. Create a Production keyset  
# 3. Copy the App ID (Client ID) and Cert ID (Client Secret)
EBAY_APP_ID=
EBAY_CLIENT_SECRET=

# ── Alchemy (Ethereum NFT Data) ────────────────────────────
# Get your key at: https://dashboard.alchemy.com
# Used to pull on-chain NFT holder data
ALCHEMY_API_KEY=

# ── Pokémon TCG API ────────────────────────────────────────
# Optional — the free tier works without a key (60 req/min)
# Get a key for higher limits: https://dev.pokemontcg.io
POKEMON_TCG_API_KEY=
