# Smithery deployment image for the HOSTED remote server (mcp_remote.py) —
# a thin proxy over the public oracle APIs; needs no local data or models.
# The local-first stdio server (server.py) is NOT this image: it wants local
# DBs and models and lives on PyPI for people who run it themselves.
FROM python:3.12-slim
WORKDIR /app
COPY mcp_remote.py .
RUN pip install --no-cache-dir "mcp>=1.2" httpx uvicorn
ENV X402_BASE_URL=https://oracle.the-undesirables.com
# Smithery injects PORT; serve streamable HTTP at /mcp on it.
CMD ["sh", "-c", "python mcp_remote.py --transport streamable-http --host 0.0.0.0 --port ${PORT:-8080}"]
